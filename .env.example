# --- AI provider -----------------------------------------------------------
# "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, defaults to gemini-3.1-flash-lite-image
# GEMINI_MODEL=gemini-3.1-flash-lite-image

# Only needed when AI_PROVIDER=openai: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional, defaults to gpt-image-1
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- App -------------------------------------------------------------------
# Long random string used to sign login cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Set to "false" to stop new sign-ups once your own account exists
ALLOW_REGISTRATION=true

# Max upload size for floor plans, in MB
MAX_UPLOAD_MB=10

# Where the SQLite database and images are stored (Docker uses /data)
# DATA_DIR=./data

# Login cookies are HTTPS-only in production. Set to "false" only if you
# serve the app over plain HTTP (not recommended).
# COOKIE_SECURE=true
